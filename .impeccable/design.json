  "narrative": {
    "overview": "The portfolio uses Inter, faceted background images and green accents. Large headings introduce the work; fine borders separate lists, controls and project details. Nearly opaque panels keep interactive examples readable against the background.\n\nThis document records the existing implementation. Mineral and Slate are the approved light and dark treatments. Their application is described below as theme-specific behavior; neither palette is a universal default for new products or unrelated interfaces.",
    "keyCharacteristics": [
      "Inter variable typography with compact supporting labels.",
      "Faceted page backgrounds beneath a translucent color wash.",
      "Bordered panels and restrained green interaction states.",
      "Responsive layouts and reduced-motion support."
    ],
    "rules": [
      {
        "name": "Semantic theme colors",
        "body": "Shared components use the semantic properties from styles/themes.css so the selected theme supplies their colors.",
        "section": "colors"
      },
      {
        "name": "Borders before shadows",
        "body": "The current portfolio panels and work demos establish boundaries through borders and tonal fills; their styles do not use box shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the existing semantic CSS properties when extending this portfolio.",
      "Do keep keyboard focus visible and preserve native control semantics.",
      "Do retain both approved background images and theme-aware particle colors.",
      "Do keep the work demonstrations visibly identified as fictional, local reconstructions."
    ],
    "donts": [
      "Don't hard-code a single theme's text or panel colors into shared components.",
